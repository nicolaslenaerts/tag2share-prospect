# Copie ce fichier en .env.local et remplis les valeurs.

# Mot de passe d'accès à l'app (auth partagée). Sans lui, l'app reste verrouillée
# (login impossible) hormis /api/unsubscribe et /api/webhooks/resend.
APP_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ============================================================
# MULTI-MARQUE
# ============================================================
# L'identité d'une marque (nom, couleurs, logo, catalogue, gabarit d'email,
# positionnement IA) est déclarée EN CODE dans lib/brands/<slug>.ts, puis
# enregistrée dans lib/brands/index.ts. Voir lib/brands/_example.ts.
#
# L'ADRESSE D'ENVOI de chaque marque se saisit dans l'interface (page
# /reglages) et est stockée en base (table brand_settings). Les variables
# ci-dessous ne servent plus que de valeur initiale / de repli.
#
# UN SEUL compte Resend pour toutes les marques : une clé API et un secret de
# webhook communs, avec un domaine vérifié par marque.
# ============================================================

# Clé API Resend, commune à toutes les marques.
RESEND_API_KEY=
# Secret de signature du webhook Resend (whsec_...), commun lui aussi.
# UN SEUL endpoint à déclarer : https://<APP_URL>/api/webhooks/resend
# (la marque de chaque événement est retrouvée depuis le payload).
RESEND_WEBHOOK_SECRET=

# --- Repli pour la marque par défaut (tag2share) ---
# Utilisés seulement tant que rien n'est enregistré dans /reglages.
# Format "Nom <adresse>" ou adresse nue.
RESEND_FROM=Nicolas de Tag2Share <nicolas@reach.tag2share.com>
# Adresse de réponse (les réponses arrivent ici, pas sur le domaine d'envoi).
RESEND_REPLY_TO=nicolas@tag2share.com
# Adresse vers laquelle les emails de TEST sont redirigés.
TEST_EMAIL=you@example.com

# Plafond d'envois par jour ET PAR MARQUE (0 = illimité) et délai entre envois
# (ms). Déclarés dans lib/brands/<slug>.ts ; ces variables les surchargent pour
# la marque par défaut. 50 = marge sous la limite Resend gratuit (100/jour).
DAILY_SEND_CAP=50
SEND_DELAY_MS=1200

# --- Marque supplémentaire (exemple, à adapter au slug réel) ---
# Rien d'obligatoire : son adresse d'envoi se saisit dans /reglages.
# TEST_EMAIL_EXEMPLE=
# DAILY_SEND_CAP_EXEMPLE=20

# URL publique de l'app (liens de désinscription absolus dans les emails).
APP_URL=https://marketing.tag2share.com
# Secret pour signer les liens de désinscription (sinon SUPABASE_SERVICE_ROLE_KEY).
# ⚠️ Ne pas le changer : les liens déjà envoyés cesseraient de fonctionner.
UNSUBSCRIBE_SECRET=
